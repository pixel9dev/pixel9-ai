{
  "name": "telolexic-supervisor",
  "displayName": "Telolexic Supervisor",
  "description": "Agentic AI Supervisor using Vilomapatha protocol",
  "version": "1.0.0",
  "publisher": "pixel9",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "telolexic.auditSelection",
        "title": "Telolexia: Audit Code Selection (Reverse)"
      },
      {
        "command": "telolexic.generateAndAudit",
        "title": "Telolexia: Generate and Audit Code via LLM"
      },
      {
        "command": "telolexic.auditWithAST",
        "title": "Telolexia: Audit with TAP-3.0 (AST-based)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "d3": "^7.8.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/d3": "^7.4.0",
    "typescript": "^5.1.3"
  }
}
